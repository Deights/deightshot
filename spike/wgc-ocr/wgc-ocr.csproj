<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 22621: GraphicsCaptureSession.IsBorderRequired (sari yakalama cercevesini kapatma)
         bu surumden itibaren var. Gercek uygulamada 19041'e dusup bu ozelligi
         calisma zamaninda yoklamak gerekebilir. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Shot88.Spike</RootNamespace>
    <AssemblyName>wgc-ocr</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
  </ItemGroup>

</Project>
