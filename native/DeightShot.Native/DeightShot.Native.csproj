<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 22621: GraphicsCaptureSession.IsBorderRequired icin gerekli.
         Win10 destegi istenirse 19041'e dusup bu ozelligi calisma zamaninda yokla. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>DeightShot.Native</RootNamespace>
    <AssemblyName>deightshot-native</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- YAYIN GIZLILIGI: .NET derlemesi kaynak dosya yollarini exe/dll/pdb
         icine gomer. Bu proje surucu kokunde (C: altinda dogrudan) durdugu
         icin kullanici adi SANS ESERI sizmiyordu; proje kullanici klasoru
         altinda olsaydi dagitilan her ikilinin icinde kullanici adi yazacakti.
         PathMap yollari goreli hale getirir — sansi ayara cevirir. -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
  </ItemGroup>

</Project>
